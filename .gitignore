# .gitignore

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environment
# Never commit your virtual environment folder!
venv/
env/
.venv/
.env/

# Distribution / Installation
# These are generated by `python -m build` and should not be in version control.
build/
dist/
*.egg-info/
*.egg
src/*.egg-info/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml


# IDE / Editor configuration
.vscode/
.idea/

# Operating System files
.DS_Store
Thumbs.db

# Generated demo outputs (see README walkthrough)
examples/out_*.svg

# osmnx HTTP cache from examples/fetch_osm_example.py
cache/
