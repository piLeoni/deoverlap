{
  "name": "deoverlap",
  "version": "4.2.0",
  "description": "De-overlap vector strokes to prevent overdrawing (Node.js bindings for deoverlap-core)",
  "license": "MIT",
  "repository": "https://github.com/piLeoni/deoverlap",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "deoverlap-node",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "engines": {
    "node": ">= 16"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test test/*.mjs",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm --skip-gh-release",
    "version": "napi version"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  }
}
